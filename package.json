{
	"name": "better-blockquote-editing",
	"version": "0.2.5",
	"description": "Inline native Markdown editing for Obsidian callouts and blockquotes",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test tests/*.test.mjs",
		"test:obsidian": "node tests/run-native-smoke.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"engines": { "node": ">=22" },
	"devDependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@lezer/common": "^1.5.5",
		"@types/node": "^22.5.4",
		"@typescript-eslint/eslint-plugin": "^8.4.0",
		"@typescript-eslint/parser": "^8.4.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.23.1",
		"obsidian": "latest",
		"obsidian-typings": "latest",
		"tslib": "^2.6.3",
		"typescript": "5.7.2"
	},
	"dependencies": {
		"@lezer/markdown": "1.8.1",
		"@mnaoumov/obsidian-lib": "11.0.0"
	}
}
